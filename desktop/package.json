{
  "name": "fieldnotes-workspace-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Fieldnotes Workspace for macOS",
  "main": "main.cjs",
  "author": "Fieldnotes Workspace",
  "scripts": {
    "build:mac": "electron-builder --mac dmg --arm64"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.fieldnotes.workspace",
    "productName": "Fieldnotes Workspace",
    "files": ["main.cjs", "config.json", "icon.png", "package.json"],
    "directories": { "output": "../outputs/desktop", "buildResources": "." },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "icon.png",
      "target": ["dmg"],
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": { "title": "Fieldnotes Workspace" }
  }
}
